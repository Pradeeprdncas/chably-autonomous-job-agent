# Leave DATABASE_URL empty to use the DATA_DIR SQLite database.
APP_ENV=development
FRONTEND_URL=http://localhost:5173
# Production: https://<your-frontend-domain>
DATA_DIR=./data
DATABASE_URL=
CHROMA_PATH=./data/chroma
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
AI_MOCK_MODE=false
SEARCH_PROVIDER=searxng
SEARCH_PROVIDER_ORDER=serper,tavily,ddg,searxng
SERPER_API_KEY=
TAVILY_API_KEY=
SEARXNG_URL=
SEARCH_MOCK_MODE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
# Separate callback for passwordless Google sign-in. Add it to the same OAuth client.
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_LOGIN_OAUTH_SCOPES=openid email profile
# Production: https://<your-render-backend-domain>/api/v1/integrations/google/callback
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.send,https://www.googleapis.com/auth/gmail.readonly
GOOGLE_OAUTH_MOCK_MODE=false
TOKEN_ENCRYPTION_KEY=
MAX_DAILY_OUTREACH=10
MAX_AUTO_SEND_DAILY=5
MAX_AUTO_REPLIES_PER_DAY=5
AUTO_REPLY_ENABLED=false
HTTP_TIMEOUT_SECONDS=15
MAX_PAGE_SIZE_MB=5
MAX_COMPANY_PAGES=6
MAX_CONCURRENT_FETCHES=5
BROWSER_FETCH_ENABLED=false
MAX_BROWSER_PAGES_PER_COMPANY=2
BROWSER_TIMEOUT_SECONDS=20
AI_TIMEOUT_SECONDS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Production: https://<your-frontend-domain> (never use *)
MAX_RESUME_SIZE_MB=10
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
MAX_SEARCH_QUERIES_PER_REQUEST=8
MAX_SEARCH_RESULTS_PER_QUERY=10
SEARCH_CACHE_TTL_SECONDS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_SENSITIVE=10
